@using System.Collections.Generic
@using System.Linq
@{
    Layout = null;
    ViewBag.Title = "Member Collection";
    var customerList = ViewBag.CustomerList as IEnumerable<APTS_WEB_APP.Models.MemberCollection.CustomerShipToLocationItem>
        ?? Enumerable.Empty<APTS_WEB_APP.Models.MemberCollection.CustomerShipToLocationItem>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Member Collection - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260630-5" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Member Collection screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Member Collection</p>
        </section>

        <form class="apts-member-form apts-member-collection-form" action="@Url.Action("MemberCollectionDetails", "MemberCollection")" method="post" data-member-collection-form data-member-collection-validation-url="@Url.Action("ValidateCollectionMember", "MemberCollection")">
            <input type="hidden" name="memberCount" value="0" data-member-collection-count-value />
            <div class="apts-field apts-custom-select-field">
                <label for="CollectionCustomer">Disassemble from</label>
                <input id="CollectionCustomer" name="customer" type="hidden" required data-custom-select-value />
                <div class="apts-custom-select" data-custom-select data-customer-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>-- Select Customer--</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu apts-custom-select__menu--searchable" role="listbox" hidden data-custom-select-menu>
                        <input class="apts-custom-select__search" type="search" placeholder="Search customer" aria-label="Search customer" data-custom-select-search />
                        @foreach (var customer in customerList)
                        {
                            <button type="button"
                                    role="option"
                                    data-value="@customer.ShipToLocCode"
                                    data-address="@customer.LocationAddress">
                                @customer.ShipToLocTitle
                            </button>
                        }
                        @if (!customerList.Any())
                        {
                            <button type="button" role="option" data-value="">No customer found</button>
                        }
                    </div>
                </div>
            </div>

            <div class="apts-field">
                <label for="CollectionMember">Scan Members to Transfer</label>
                <div class="apts-scan-input apts-receipt-scan-input">
                    <input id="CollectionMember" name="CollectionMember" type="text" placeholder="Member no." data-member-collection-input inputmode="text" autocomplete="off" autocapitalize="characters" />
                    <button type="button" aria-label="Scan member QR code" data-scan-target="#CollectionMember">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h2v2H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z" /></svg>
                    </button>
                </div>
            </div>

            <div class="apts-predispatch-command-row apts-member-collection-add-row">
                <button class="apts-form-submit" type="button" data-member-collection-add>Add</button>
            </div>

            <div class="apts-scan-summary apts-member-collection-summary">
                <span>Scanned Members</span>
                <strong data-member-collection-count>0</strong>
            </div>

            <div class="apts-sku-table-wrap apts-member-collection-table-wrap">
                <table class="apts-sku-table apts-member-collection-table apts-receipt-summary-table">
                    <thead>
                        <tr>
                            <th>Size</th>
                            <th>Type</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody data-member-collection-list>
                        <tr>
                            <td class="apts-member-collection-empty" colspan="3">No members scanned yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div hidden data-member-collection-hidden-fields></div>
            <p class="apts-form-save-status" data-member-collection-status aria-live="polite"></p>

            <div class="apts-transfer-actions apts-member-collection-actions">
                <button class="apts-form-submit" type="button" data-member-collection-clear>Clear</button>
                <button class="apts-form-submit" type="submit">Next</button>
            </div>
        </form>

        <section class="apts-receipt-group-modal" data-member-collection-group-modal hidden aria-label="Collection member details">
            <div class="apts-receipt-group-modal__panel">
                <div class="apts-receipt-group-modal__head">
                    <div>
                        <h2 data-member-collection-group-size>Members Size</h2>
                        <strong data-member-collection-group-count>Count: 0</strong>
                    </div>
                    <button type="button" data-member-collection-group-close aria-label="Close member details">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-receipt-group-modal__body">
                    <table class="apts-receipt-group-table">
                        <thead>
                            <tr>
                                <th>Sr No</th>
                                <th>Type</th>
                                <th>Members</th>
                            </tr>
                        </thead>
                        <tbody data-member-collection-group-body></tbody>
                    </table>
                </div>
            </div>
        </section>
        <section class="apts-qr-modal" data-qr-scanner hidden aria-label="QR code scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Scan QR Code</p>
                    <button type="button" data-qr-close aria-label="Close scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera">
                    <video data-qr-video playsinline muted></video>
                    <span></span>
                </div>
                <p class="apts-qr-modal__status" data-qr-status>Point the camera at the QR code.</p>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/Scripts/apts-qr-scanner.js")?v=20260622-1"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260622-1"></script>
    <script src="@Url.Content("~/Scripts/apts-background-challan.js")?v=20260707-1"></script>
    <script src="@Url.Content("~/Scripts/apts-member-collection.js")?v=20260713-1"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>



