@{
    var pageTitle = Convert.ToString(ViewBag.Title);
    var titleWords = string.IsNullOrWhiteSpace(pageTitle)
        ? new string[0]
        : pageTitle.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    var mobilePageTitle = titleWords.Length > 2
        ? titleWords[0] + " " + titleWords[1]
        : pageTitle;
}
<!-- Page Header -->
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <h1 class="page-title fw-semibold fs-20 mb-0">
        <span class="page-title-full">@pageTitle</span>
        <span class="page-title-mobile">@mobilePageTitle</span>
    </h1>
    <div class="ms-md-1 ms-0">
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="javascript:void(0);">@ViewBag.Subtitle</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewBag.Title</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header Close -->

<style>
    .page-title-mobile {
        display: none;
    }

    @@media (max-width: 575.98px) {
        .page-title-full {
            display: none;
        }

        .page-title-mobile {
            display: inline;
        }
    }
</style>
