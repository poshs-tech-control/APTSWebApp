@{
    Layout = null;
    ViewBag.Title = "Pallet Pre-Dispatch";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Pallet Pre-Dispatch - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260722-1" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Pallet Pre-Dispatch screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Pallet Pre-Dispatch</p>
        </section>

        <form class="apts-member-form apts-predispatch-form"
              action="#"
              method="post"
              enctype="multipart/form-data"
              data-predispatch-form
              data-member-validation-url="@Url.Action("ValidateMember", "PalletPreDispatch")"
              data-existing-validation-url="@Url.Action("CheckExistingPreDispatch", "PalletPreDispatch")"
              data-save-url="@Url.Action("SavePreDispatch", "PalletPreDispatch")">
            <div class="apts-field">
                <label for="PreDispatchMember">Scan any member</label>
                <div class="apts-scan-input apts-receipt-scan-input">
                    <input id="PreDispatchMember" name="PreDispatchMember" type="text" placeholder="Member" inputmode="text" data-predispatch-member-input
                           style="text-transform: uppercase;"
                           oninput="this.value = this.value.toUpperCase();"/>
                    <button type="button" aria-label="Scan member QR code" data-scan-target="#PreDispatchMember">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h2v2H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z" /></svg>
                    </button>
                </div>
                <p class="apts-field-status" data-predispatch-member-status aria-live="polite"></p>
            </div>

            <div class="apts-predispatch-command-row">
                <button class="apts-form-submit" type="button" data-predispatch-add>ADD</button>
                <button class="apts-form-submit apts-upload-button" type="button" data-vision-open>
                    <span data-upload-label>Customer Sticker</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V5m0 0-4 4m4-4 4 4M5 18h14" /></svg>
                </button>
            </div>

            <section class="apts-predispatch-card" aria-label="Pallet code details">
                <div class="apts-form-divider apts-receipt-mode">Pallet Code - <span data-predispatch-pallet-code></span></div>
                <input id="PalletCode" name="PalletCode" type="hidden" data-predispatch-pallet-code-value />

                <div class="apts-field">
                    <label for="ClientBatchNo">Client Batch No</label>
                    <input id="ClientBatchNo" name="ClientBatchNo" type="text" placeholder="Client Batch No" />
                </div>

                <div class="apts-two-column">
                    <div class="apts-field">
                        <label for="SheetLengthH1">Sheet Length L1</label>
                        <input id="SheetLengthH1" name="SheetLengthH1" type="number" readonly aria-readonly="true" min="0" step="0.01" placeholder="Sheet Length L1" inputmode="decimal" />
                    </div>
                    <div class="apts-field">
                        <label for="SheetLengthH2">Sheet Length L2</label>
                        <input id="SheetLengthH2" name="SheetLengthH2" type="number" readonly aria-readonly="true" min="0" step="0.01" placeholder="Sheet Length L2" inputmode="decimal" />
                    </div>
                </div>

                <div class="apts-two-column">
                    <div class="apts-field">
                        <label for="SheetWidth">Sheet Width</label>
                        <input id="SheetWidth" name="SheetWidth" type="number" readonly aria-readonly="true" min="0" step="0.01" placeholder="Sheet Width(MM)" inputmode="decimal" />
                    </div>
                    <div class="apts-field">
                        <label for="Thickness">Thickness</label>
                        <input id="Thickness" name="Thickness" type="number" min="0" step="0.01" placeholder="Thickness(MM)" inputmode="decimal" />
                    </div>
                </div>

                <div class="apts-field">
                    <label for="Weight">Weight</label>
                    <input id="Weight" name="Weight" type="number" min="0" step="0.01" placeholder="Weight(KG)" inputmode="decimal" />
                </div>

                <div class="apts-field">
                    <label for="StorageLocation">Storage Location</label>
                    <input id="StorageLocation" name="StorageLocation" type="text" placeholder="Storage Location" required style="text-transform: uppercase;" oninput="this.value = this.value.toUpperCase();" />
                </div>
            </section>

            <div class="apts-transfer-actions apts-predispatch-actions">
                <button class="apts-form-submit" type="reset">Clear</button>
                <button class="apts-form-submit" type="submit">Submit</button>
            </div>
            <p class="apts-form-save-status" data-predispatch-submit-status aria-live="polite"></p>
        </form>

        <section class="apts-qr-modal" data-qr-scanner hidden aria-label="QR code scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Scan QR Code</p>
                    <button type="button" data-qr-close aria-label="Close scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera">
                    <video data-qr-video playsinline muted></video>
                    <span></span>
                </div>
                <p class="apts-qr-modal__status" data-qr-status>Point the camera at the QR code.</p>
            </div>
        </section>

        <section class="apts-qr-modal" data-vision-scanner data-vision-endpoint='@Url.Action("ReadUploadText", "PalletPreDispatch")' hidden aria-label="Google Vision text scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Read Text</p>
                    <button type="button" data-vision-close aria-label="Close text scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera apts-vision-camera">
                    <video data-vision-video playsinline muted></video>
                </div>
                <div class="apts-vision-actions">
                    <button class="apts-form-submit" type="button" data-vision-capture>Capture</button>
                </div>
                <p class="apts-qr-modal__status" data-vision-status>Open camera and capture the pallet text.</p>
                <textarea class="apts-vision-text" data-vision-text rows="4" readonly hidden></textarea>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/Scripts/apts-qr-scanner.js")?v=20260611-1"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260722-1"></script>
    <script src="@Url.Content("~/Scripts/apts-pallet-predispatch.js")?v=20260722-1"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


