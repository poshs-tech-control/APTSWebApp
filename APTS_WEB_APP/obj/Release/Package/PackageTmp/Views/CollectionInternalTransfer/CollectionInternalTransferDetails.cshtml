@{
    Layout = null;
    ViewBag.Title = "Collection Internal Transfer";
    var setup = ViewBag.Setup as APTS_WEB_APP.Models.InternalTransfer.DispatchSetupInput ?? new APTS_WEB_APP.Models.InternalTransfer.DispatchSetupInput();
    var members = setup.Members ?? new List<APTS_WEB_APP.Models.InternalTransfer.TransferMemberInput>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Collection Internal Transfer - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260619-1" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Collection Internal Transfer details screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("CollectionInternalTransfer", "CollectionInternalTransfer")" aria-label="Back to collection internal transfer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Collection Internal Transfer</p>
        </section>

        <form class="apts-member-form apts-transfer-dispatch-form"
              action="@Url.Action("SubmitCollectionInternalTransfer", "CollectionInternalTransfer")"
              method="post"
              data-collection-transfer-dispatch-form
              data-collection-transfer-save-url="@Url.Action("SubmitCollectionInternalTransfer", "CollectionInternalTransfer")"
              data-collection-transfer-success-url="@Url.Action("CollectionInternalTransfer", "CollectionInternalTransfer")"
              data-collection-transfer-challan-url="@Url.Action("GenerateMemberDispatchChallan", "Challan")">
            <input type="hidden" name="UserLocationType" value="Collection Truck" />
            <input type="hidden" name="UserLocation" value="@setup.UserLocation" />
            <input type="hidden" name="ToLocationType" value="@setup.ToLocationType" />
            <input type="hidden" name="ToLocation" value="@setup.ToLocation" />
            <input type="hidden" name="GenerateChallan" value="true" />
            @for (int index = 0; index < members.Count; index++)
            {
                <input type="hidden" name="Members[@index].Rfid" value="@members[index].Rfid" />
                <input type="hidden" name="Members[@index].TagRfid" value="@members[index].TagRfid" />
                <input type="hidden" name="Members[@index].MemberCode" value="@members[index].MemberCode" />
                <input type="hidden" name="Members[@index].MemberType" value="@members[index].MemberType" />
                <input type="hidden" name="Members[@index].MemberSize" value="@members[index].MemberSize" />
                <input type="hidden" name="Members[@index].MemberWeight" value="@members[index].MemberWeight" />
                <input type="hidden" name="Members[@index].MemberDimension" value="@members[index].MemberDimension" />
            }
            <div class="apts-field">
                <label for="TruckNumber">Truck Number</label>
                <input id="TruckNumber" name="TruckNumber" type="text" value="@ViewBag.TruckNo" placeholder="Truck Number" readonly />
            </div>

            <div class="apts-field">
                <label for="DriverName">Driver Name</label>
                <input id="DriverName" name="DriverName" type="text" value="@ViewBag.DriverName" placeholder="Driver Name" readonly />
            </div>

            <div class="apts-field">
                <label for="DriverContactNo">Driver Contact No.</label>
                <input id="DriverContactNo" name="DriverContactNo" type="tel" value="@ViewBag.DriverContactNo" placeholder="Driver Contact No." inputmode="tel" readonly />
            </div>

            <div class="apts-field">
                <label for="TransporterName">Transporter Name</label>
                <input id="TransporterName" name="TransporterName" type="text" value="@ViewBag.TransporterName" placeholder="Transporter Name" readonly />
            </div>

            <div class="apts-transfer-actions">
                <button class="apts-form-submit" type="reset">Clear</button>
                <button class="apts-form-submit" type="submit">Submit</button>
            </div>
            <p class="apts-form-save-status" data-collection-transfer-dispatch-status aria-live="polite"></p>
        </form>
    </main>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260604"></script>
    <script src="@Url.Content("~/Scripts/apts-collection-internal-transfer-dispatch.js")?v=20260707-2"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>





