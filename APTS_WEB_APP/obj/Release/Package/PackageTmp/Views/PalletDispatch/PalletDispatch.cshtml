@{
    Layout = null;
    ViewBag.Title = "Pallet Dispatch";
    var fromLocationCode = Convert.ToString(ViewBag.FromLocationCode ?? string.Empty);
    var fromLocationTitle = Convert.ToString(ViewBag.FromLocationTitle ?? ViewBag.FromLocationCode ?? string.Empty);
    var toCustomerList = ViewBag.ToCustomerList ?? new List<object>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Pallet Dispatch - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260606-3" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Pallet Dispatch screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Pallet Dispatch</p>
        </section>

        <form class="apts-member-form apts-pallet-dispatch-form" action="@Url.Action("PalletDispatchDetails", "PalletDispatch")" method="post">
            <input id="DispatchFromLocation" name="fromLocation" type="hidden" value="@fromLocationCode" />

            <div class="apts-field apts-custom-select-field">
                <label for="DispatchCustomer">To Customer</label>
                <input id="DispatchCustomer" name="customer" type="hidden" required data-custom-select-value />
                <div class="apts-custom-select" data-custom-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>--Select--</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu apts-custom-select__menu--searchable" role="listbox" hidden data-custom-select-menu>
                        <input class="apts-custom-select__search" type="search" placeholder="Search customer" aria-label="Search customer" data-custom-select-search />
                        @foreach (var customer in toCustomerList)
                        {
                            <button type="button"
                                    role="option"
                                    data-value="@customer.ShipToLocCode"
                                    data-address="@customer.LocationAddress">
                                @customer.ShipToLocTitle
                            </button>
                        }
                        @if (toCustomerList.Count == 0)
                        {
                            <button type="button" role="option" data-value="">No customer found</button>
                        }
                    </div>
                </div>
            </div>

            <div class="apts-field apts-custom-select-field">
                <label for="DispatchConsignee">Consignee</label>
                <input id="DispatchConsignee" name="consignee" type="hidden" required data-custom-select-value />
                <div class="apts-custom-select" data-custom-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>--Select--</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu apts-custom-select__menu--searchable" role="listbox" hidden data-custom-select-menu>
                        <input class="apts-custom-select__search" type="search" placeholder="Search consignee" aria-label="Search consignee" data-custom-select-search />
                        @foreach (var customer in toCustomerList)
                        {
                            <button type="button"
                                    role="option"
                                    data-value="@customer.ShipToLocCode"
                                    data-address="@customer.LocationAddress">
                                @customer.ShipToLocTitle
                            </button>
                        }
                        @if (toCustomerList.Count == 0)
                        {
                            <button type="button" role="option" data-value="">No consignee found</button>
                        }
                    </div>
                </div>
            </div>
            <div class="apts-field">
                <label for="CustomerAddress">Address</label>
                <textarea id="CustomerAddress" name="CustomerAddress" placeholder="Customer address" rows="3" readonly></textarea>
            </div>

            <fieldset class="apts-dispatch-scan-mode">
                <legend>Scan Type</legend>
                <label><input type="radio" name="scanType" value="ClientBatchNo" checked /><span>Client Batch No</span></label>
                <label><input type="radio" name="scanType" value="MemberId" /><span>Member ID</span></label>
            </fieldset>

            <div class="apts-field">
                <label for="DispatchMemberId" data-dispatch-scan-label>Client Batch No</label>
                <div class="apts-scan-input apts-receipt-scan-input">
                    <input id="DispatchMemberId" name="DispatchMemberId" type="text" placeholder="Client Batch No" inputmode="text" 
                           style="text-transform: uppercase;"
                           oninput="this.value = this.value.toUpperCase();"/>
                    <button type="button" aria-label="Scan member QR code" data-scan-target="#DispatchMemberId">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h2v2H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z" /></svg>
                    </button>
                </div>
                <p class="apts-field-status" data-dispatch-validation-status></p>
            </div>

            <div class="apts-predispatch-command-row">
                <button class="apts-form-submit" type="button" data-dispatch-add>ADD</button>
                <button class="apts-form-submit apts-upload-button" type="button" data-vision-open>
                    <span data-upload-label>Loading Slip</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V5m0 0-4 4m4-4 4 4M5 18h14" /></svg>
                </button>
            </div>

            <div class="apts-dispatch-table-head" aria-hidden="true">
                <span>PreDis Code</span>
                <span>Client Batch No</span>
                <span>Sheet Size</span>
            </div>

            <section class="apts-scanned-members" data-dispatch-list>
                <p>No dispatch items added yet.</p>
            </section>

            <button class="apts-form-submit apts-dispatch-next" type="submit">Next</button>
        </form>

        <section class="apts-qr-modal" data-qr-scanner hidden aria-label="QR code scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Scan QR Code</p>
                    <button type="button" data-qr-close aria-label="Close scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera">
                    <video data-qr-video playsinline muted></video>
                    <span></span>
                </div>
                <p class="apts-qr-modal__status" data-qr-status>Point the camera at the QR code.</p>
            </div>
        </section>

        <section class="apts-qr-modal" data-vision-scanner data-vision-endpoint='@Url.Action("ReadUploadText", "PalletDispatch")' data-dispatch-validation-endpoint='@Url.Action("ValidateDispatchScan", "PalletDispatch")' data-dispatch-batch-endpoint='@Url.Action("GetDispatchBatches", "PalletDispatch")' hidden aria-label="Google Vision text scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Read Text</p>
                    <button type="button" data-vision-close aria-label="Close text scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera apts-vision-camera">
                    <video data-vision-video playsinline muted></video>
                </div>
                <div class="apts-vision-actions">
                    <button class="apts-form-submit" type="button" data-vision-capture>Capture</button>
                    <label class="apts-form-submit apts-upload-button" for="DispatchVisionFile">
                        <span>Choose Image</span>
                    </label>
                    <input id="DispatchVisionFile" type="file" accept="image/*" hidden data-vision-file />
                </div>
                <p class="apts-qr-modal__status" data-vision-status>Open camera and capture the dispatch text.</p>
                <textarea class="apts-vision-text" data-vision-text rows="4" readonly hidden></textarea>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/Scripts/apts-qr-scanner.js")?v=20260611-1"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260604"></script>
    <script src="@Url.Content("~/Scripts/apts-background-challan.js")?v=20260731-1"></script>
    <script src="@Url.Content("~/Scripts/apts-pallet-dispatch.js")?v=20260710-1"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


