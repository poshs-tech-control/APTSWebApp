@{
    Layout = null;
    ViewBag.Title = "Member Receipt";
    var receiptFrom = string.IsNullOrWhiteSpace(ViewBag.ReceiptFrom as string) ? "" : ViewBag.ReceiptFrom as string;
    var receiptLocation = string.IsNullOrWhiteSpace(ViewBag.ReceiptLocation as string) ? "" : ViewBag.ReceiptLocation as string;
    var receiptLocationName = string.IsNullOrWhiteSpace(ViewBag.ReceiptLocationName as string) ? "Selected Location" : ViewBag.ReceiptLocationName as string;
    var receiptFromTitle = string.IsNullOrWhiteSpace(ViewBag.ReceiptFromTitle as string) ? "Location" : ViewBag.ReceiptFromTitle as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Member Receipt Scan - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260727-receipt-discrepancy-grid" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen apts-receipt-scan-screen" aria-label="Member Receipt scan screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Member Receipt</p>
        </section>

        <form class="apts-member-form apts-receipt-scan-form"
              action="#"
              method="post"
              data-member-receipt-form
              data-receipt-validation-url="@Url.Action("ValidateReceiptMember", "MemberReceipt")"
              data-receipt-save-url="@Url.Action("SaveReceipt", "MemberReceipt")">
            <input type="hidden" name="ReceiptFrom" value="@receiptFrom" />
            <input type="hidden" name="ReceiptLocation" value="@receiptLocation" />
            <input type="hidden" name="ReceiptLocationName" value="@receiptLocationName" />

            <div class="apts-receipt-context">
                <span>@receiptFromTitle</span>
                <strong>@receiptLocationName</strong>
            </div>

            <div class="apts-field">
                <label for="ReceiptMemberNo">Scan any member</label>
                <div class="apts-scan-input apts-receipt-scan-input">
                    <input id="ReceiptMemberNo" name="ReceiptMemberNo" type="text" placeholder="Member no." data-receipt-member-input inputmode="text" />
                    <button type="button" aria-label="Scan member QR code" data-scan-target="#ReceiptMemberNo">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h2v2H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z" /></svg>
                    </button>
                </div>
            </div>

            <button class="apts-form-submit apts-receipt-add" type="button" data-receipt-add>Add</button>

            <div class="apts-form-divider">Summary Data</div>

            <div class="apts-scan-summary">
                <span>Scanned Members</span>
                <strong data-receipt-count>0</strong>
            </div>

            <section class="apts-scanned-members" data-receipt-list>
                <p>No members scanned yet.</p>
            </section>

            <div class="apts-receipt-actions">
                <button class="apts-form-submit" type="button" data-receipt-clear>Clear</button>
                <button class="apts-form-submit apts-loss-button" type="button" data-receipt-discrepancy>Discrepancy</button>
                <button class="apts-form-submit" type="submit">Save</button>
            </div>
            <p class="apts-form-save-status" data-receipt-save-status aria-live="polite"></p>
        </form>


        <section class="apts-receipt-group-modal" data-receipt-group-modal hidden aria-label="Receipt member details">
            <div class="apts-receipt-group-modal__panel">
                <div class="apts-receipt-group-modal__head">
                    <div>
                        <h2 data-receipt-group-size>Members Size</h2>
                        <strong data-receipt-group-count>Count: 0</strong>
                    </div>
                    <button type="button" data-receipt-group-close aria-label="Close member details">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-receipt-group-modal__body">
                    <table class="apts-receipt-group-table">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Members</th>
                                <th><input type="checkbox" data-receipt-discrepancy-select-all aria-label="Mark all discrepancy" /></th>
                                <th>Discrepancy</th>
                            </tr>
                        </thead>
                        <tbody data-receipt-group-body></tbody>
                    </table>
                </div>
            </div>
        </section>
        <section class="apts-qr-modal" data-qr-scanner hidden aria-label="QR code scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Scan QR Code</p>
                    <button type="button" data-qr-close aria-label="Close scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera">
                    <video data-qr-video playsinline muted></video>
                    <span></span>
                </div>
                <p class="apts-qr-modal__status" data-qr-status>Point the camera at the QR code.</p>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/Scripts/apts-qr-scanner.js")?v=20260611-1"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260604"></script>
    <script src="@Url.Content("~/Scripts/apts-member-receipt.js")?v=20260727-discrepancy-grid"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


