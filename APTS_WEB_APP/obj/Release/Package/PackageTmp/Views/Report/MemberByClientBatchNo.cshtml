@{
    Layout = null;
    ViewBag.Title = "Members Details By ClientBatchNo";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Members Details By ClientBatchNo - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260620-3" rel="stylesheet" />
    <style>
        .apts-client-batch-report-body { overflow: hidden; }
        .apts-client-batch-report-body .apts-form-screen {
            display: flex;
            flex-direction: column;
            height: 100vh;
            height: 100dvh;
            min-height: 0;
            overflow: hidden;
        }
        .apts-client-batch-report-body .apts-form-header,
        .apts-client-batch-report-body .apts-form-title { flex-shrink: 0; }
        .apts-client-batch-report-body .apts-query-report-form {
            flex: 1;
            min-height: 0;
            grid-template-rows: auto auto minmax(0, 1fr) auto;
        }
        .apts-client-batch-report-data {
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior-y: contain;
            -webkit-overflow-scrolling: touch;
            scrollbar-gutter: stable;
        }
        .apts-client-batch-report-data > * + * { margin-top: 16px; }
        .apts-client-batch-report-data:focus-visible { outline: 2px solid #72ead2; outline-offset: -2px; }
        .apts-client-batch-results { display: grid; gap: 16px; }
        .apts-client-batch-results .apts-query-detail-row strong,
        .apts-client-batch-results .apts-query-detail-row span { overflow-wrap: anywhere; }
    </style>
</head>
<body class="apts-form-body apts-client-batch-report-body">
    <main class="apts-form-screen apts-query-report-screen" aria-label="Members Details By ClientBatchNo report screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Report", "Report")" aria-label="Back to reports">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title"><p>Members Details By ClientBatchNo</p></section>

        <form class="apts-member-form apts-query-report-form"
              action="@Url.Action("GetMemberByClientBatchNoReport", "Report")"
              method="post"
              data-client-batch-report-form
              data-client-batch-report-url="@Url.Action("GetMemberByClientBatchNoReport", "Report")">
            <div class="apts-field">
                <label for="ReportClientBatchNo">Client Batch No</label>
                <div class="apts-scan-input apts-query-scan-input">
                    <input id="ReportClientBatchNo" name="ClientBatchNo" type="text" placeholder="Scan or enter Client Batch No" maxlength="50" inputmode="text" required data-client-batch-input />
                    <button type="button" aria-label="Scan Client Batch No QR code" data-scan-target="#ReportClientBatchNo">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h2v2H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z" /></svg>
                    </button>
                </div>
            </div>
            <button class="apts-form-submit apts-query-submit" type="submit">Submit</button>
            <section class="apts-client-batch-report-data" tabindex="0" aria-label="Scrollable report details">
                <p class="apts-form-save-status" data-client-batch-status aria-live="polite"></p>
                <div class="apts-form-divider apts-query-report-heading">Report Details</div>
                <p class="apts-form-save-status" data-client-batch-count aria-live="polite">Records: 0</p>
                <section class="apts-client-batch-results" data-client-batch-results aria-label="Members for Client Batch No"></section>
            </section>
            <button class="apts-form-submit apts-query-clear" type="reset">Clear</button>
        </form>

        <section class="apts-qr-modal" data-qr-scanner hidden aria-label="QR code scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Scan QR Code</p>
                    <button type="button" data-qr-close aria-label="Close scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera">
                    <video data-qr-video playsinline muted></video><span></span>
                </div>
                <p class="apts-qr-modal__status" data-qr-status>Point the camera at the QR code.</p>
            </div>
        </section>
    </main>
    <script src="@Url.Content("~/Scripts/apts-qr-scanner.js")?v=20260602"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260620"></script>
    <script src="@Url.Content("~/Scripts/apts-member-by-client-batch-no-report.js")?v=20261026-3-last-status"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>
