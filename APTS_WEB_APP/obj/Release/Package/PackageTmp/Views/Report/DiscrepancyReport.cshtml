@{
    Layout = null;
    ViewBag.Title = "Discrepancy Report";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Discrepancy Report - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260620-3" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Discrepancy Report screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Report", "Report")" aria-label="Back to reports">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Discrepancy Report</p>
        </section>

        <form class="apts-member-form apts-report-filter-form"
              action="#"
              method="post"
              data-discrepancy-report-form
              data-discrepancy-report-url="@Url.Action("GetDiscrepancyReport", "Report")">
            <div class="apts-form-divider apts-report-tab">Report</div>

            <fieldset class="apts-report-mode apts-report-mode-two">
                <legend>Discrepancy Type</legend>
                <label><input type="radio" name="DiscrepancyType" value="Disassemble" checked /><span>Disassemble</span></label>
                <label><input type="radio" name="DiscrepancyType" value="Received" /><span>Received</span></label>
            </fieldset>

            <div class="apts-report-date-actions">
                <div class="apts-field">
                    <label for="DiscrepancyFromDate">From Date</label>
                    <input id="DiscrepancyFromDate" name="FromDate" type="date" />
                </div>
                <div class="apts-field">
                    <label for="DiscrepancyToDate">To Date</label>
                    <input id="DiscrepancyToDate" name="ToDate" type="date" />
                </div>
                <button class="apts-form-submit" type="submit">Submit</button>
            </div>
            <p class="apts-form-save-status" data-discrepancy-status aria-live="polite"></p>

            <div class="apts-report-summary-actions">
                <section class="apts-report-summary" aria-label="Discrepancy totals">
                    <span>Damage: <strong data-discrepancy-damage-count>0</strong></span>
                    <span>Loss: <strong data-discrepancy-loss-count>0</strong></span>
                </section>
                <button class="apts-report-export-button"
                        type="button"
                        data-discrepancy-export
                        title="Download Excel"
                        aria-label="Download Excel"
                        disabled>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                        <path d="M14 3v5h5" />
                        <path d="m9 11 6 6" />
                        <path d="m15 11-6 6" />
                    </svg>
                </button>
            </div>

            <section class="apts-report-table apts-report-table-six" aria-label="Discrepancy report result">
                <div class="apts-report-table__head">
                    <span>Member</span>
                    <span>From</span>
                    <span>To</span>
                    <span>EntryBy</span>
                    <span>Status</span>
                    <span>Date</span>
                </div>
                <div class="apts-report-table__body" data-discrepancy-rows></div>
            </section>
        </form>
    </main>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260620"></script>
    <script src="@Url.Content("~/Scripts/apts-discrepancy-report.js")?v=20260620-3"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


