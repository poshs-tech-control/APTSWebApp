@model APTS_WEB_APP.Models.PalletDispatcch.PalletDispatchDetailsInput
@{
    Layout = null;
    ViewBag.Title = "Pallet Dispatch";
    var dispatchItems = Model != null && Model.DispatchItems != null
        ? Model.DispatchItems
        : new List<APTS_WEB_APP.Models.PalletDispatcch.DispatchItemInput>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Pallet Dispatch - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260606-3" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Pallet Dispatch details screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("PalletDispatch", "PalletDispatch")" aria-label="Back to pallet dispatch">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Pallet Dispatch</p>
        </section>

        <form class="apts-member-form apts-transfer-dispatch-form"
              action="@Url.Action("SaveDispatch", "PalletDispatch")"
              method="post"
              data-dispatch-save-form
              data-dispatch-start-url="@Url.Action("PalletDispatch", "PalletDispatch")"
              data-dispatch-challan-url="@Url.Action("GeneratePalletDispatchChallan", "Challan")">
            <input type="hidden" name="FromLocation" value="@(Model != null ? Model.FromLocation : string.Empty)" />
            <input type="hidden" name="ShipToLocation" value="@(Model != null ? Model.Customer : string.Empty)" />
            <input type="hidden" name="Consignee" value="@(Model != null ? Model.Consignee : string.Empty)" />
            <input type="hidden" name="GenerateChallan" value="true" />
            @for (var index = 0; index < dispatchItems.Count; index++)
            {
                <input type="hidden" name="DispatchItems[@index].PreDispatchCode" value="@dispatchItems[index].PreDispatchCode" />
                <input type="hidden" name="DispatchItems[@index].PalletCode" value="@dispatchItems[index].PalletCode" />
                <input type="hidden" name="DispatchItems[@index].ClientBatchNo" value="@dispatchItems[index].ClientBatchNo" />
                <input type="hidden" name="DispatchItems[@index].SheetSize" value="@dispatchItems[index].SheetSize" />
            }
            <div class="apts-field">
                <label for="TruckNumber">Truck Number</label>
                <input id="TruckNumber" name="TruckNumber" type="text" placeholder="Truck Number" maxlength="10"
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();"/>
            </div>

            <div class="apts-field">
                <label for="DriverName">Driver Name</label>
                <input id="DriverName" name="DriverName" type="text" placeholder="Driver Name" 
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();"/>
            </div>

            <div class="apts-field">
                <label for="DriverContactNo">Driver Contact No.</label>
                <input id="DriverContactNo" name="DriverContactNo" type="tel" placeholder="Driver Contact No." inputmode="tel" 
                       maxlength="10"/>
            </div>

            <div class="apts-field">
                <label for="TransporterName">Transporter Name</label>
                <input id="TransporterName" name="TransporterName" type="text" placeholder="Transporter Name" 
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();"/>
            </div>

            @*<label class="apts-transfer-check">
                <input type="checkbox" name="GenerateChallan" value="true" checked />
                <span>Generate Challan</span>
            </label>*@

            <div class="apts-transfer-actions">
                <button class="apts-form-submit" type="reset">Clear</button>
                <button class="apts-form-submit" type="submit">Submit</button>
            </div>
            <p class="apts-form-save-status" data-dispatch-save-status aria-live="polite"></p>
        </form>
    </main>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260606-1"></script>
    <script src="@Url.Content("~/Scripts/apts-pallet-dispatch-details.js")?v=20260722-background-challan"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>




