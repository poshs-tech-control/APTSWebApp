@{
    Layout = null;
    ViewBag.Title = "Pallet Assemble";
    string sessionCustomerCode = Convert.ToString(ViewBag.SessionCustomerCode);
    string sessionLocationCode = Convert.ToString(ViewBag.SessionLocationCode);
    string sessionCustomerTitle = string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.SessionCustomerTitle)) ? "Selected Customer" : Convert.ToString(ViewBag.SessionCustomerTitle);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Pallet Assemble - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260724-1" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Pallet Assemble screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Pallet Assemble</p>
        </section>

        <form class="apts-member-form" action="#" method="post" data-assemble-orders-url="@Url.Action("GetPalletOrderDetails", "PalletAssemble")" data-assemble-validate-url="@Url.Action("ValidateAssembleMember", "PalletAssemble")" data-assemble-bypass-url="@Url.Action("ContinueAssembleBypass", "PalletAssemble")" data-assemble-save-url="@Url.Action("SubmitPalletAssemble", "PalletAssemble")" data-assemble-qr-url="@Url.Action("GeneratePalletQrCode", "PalletAssemble")">
            <input id="AssembleCustomer" name="AssembleCustomer" type="hidden" value="@sessionCustomerCode" data-assemble-customer data-assemble-location-code="@sessionLocationCode" />
            <input id="AssembleLocation" name="AssembleLocation" type="hidden" value="@sessionLocationCode" />

            <div class="apts-receipt-context">
                <span>Client</span>
                <strong>@sessionCustomerTitle</strong>
            </div>

            <div class="apts-form-divider">Pallet Order List</div>

            <section class="apts-order-list" data-assemble-orders>
                <p>Select a customer to view pallet orders.</p>
            </section>

        </form>

        <section class="apts-order-detail-modal" data-assemble-detail hidden aria-label="Pallet order details">
            <div class="apts-order-detail-modal__panel">
                <div class="apts-qr-modal__head">
                    <p class="apts-assemble-detail-title">
                        <span>Order Details</span>
                        <strong data-detail-title-customer></strong>
                    </p>
                    <button type="button" data-order-detail-close aria-label="Close order details">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>

                <div class="apts-assemble-detail-scroll">
                    <dl class="apts-assemble-detail-list">
                        <div><dt>Sheet Width</dt><dd data-detail="SheetWidth"></dd></div>
                        <div><dt>Sheet Length L1</dt><dd data-detail="SheetLength1"></dd></div>
                        <div><dt>Sheet Length L2</dt><dd data-detail="SheetLength2"></dd></div>
                        <div><dt>CM Size</dt><dd data-detail="CMSize"></dd></div>
                        <div><dt>LM1 Size</dt><dd data-detail="LM1Size"></dd></div>
                        <div><dt>LM2 Size</dt><dd data-detail="LM2Size"></dd></div>
                        <div><dt>CM Qty</dt><dd data-detail="CMSizeQty"></dd></div>
                        <div><dt>LM1 Qty</dt><dd data-detail="LM1SizeQty"></dd></div>
                        <div><dt>LM2 Qty</dt><dd data-detail="LM2SizeQty"></dd></div>
                        <div class="apts-assemble-count apts-assemble-count--order"><dt>Order Count</dt><dd data-detail="OrderCounts"></dd></div>
                        <div class="apts-assemble-count apts-assemble-count--assembled"><dt>Assemble Count</dt><dd data-detail="AssembleCounts"></dd></div>
                        <div class="apts-assemble-count apts-assemble-count--pending"><dt>Pending Count</dt><dd data-detail="PendingCount"></dd></div>
                    </dl>

                    <section class="apts-assemble-popup-scan">
                        <div class="apts-field">
                            <label for="ScannedMemberId">Member QR Code</label>
                            <div class="apts-scan-input">
                                <input id="ScannedMemberId" name="ScannedMemberId" type="text" placeholder="Scan member QR code" data-assemble-member-input inputmode="text" />
                                <button type="button" aria-label="Scan member QR code" data-scan-target="#ScannedMemberId">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h2v2H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z" /></svg>
                                </button>
                            </div>
                            <p class="apts-field-status" data-assemble-member-status aria-live="polite"></p>
                        </div>

                        <button class="apts-form-submit" type="button" data-assemble-add>Add Member</button>

                        <div class="apts-scan-summary">
                            <span>Scanned Members</span>
                            <strong data-member-count>0</strong>
                        </div>

                        <section class="apts-scanned-members" data-member-list>
                            <p>No members scanned yet.</p>
                        </section>

                        <button class="apts-form-submit" type="button" data-assemble-submit>Submit</button>
                    </section>
                </div>

                <section class="apts-assemble-message-modal" data-assemble-message hidden aria-label="Pallet assemble message">
                    <div class="apts-assemble-message-modal__panel">
                        <div class="apts-process-popup__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
                        </div>
                                                <p data-assemble-message-text></p>
                        <div class="apts-assemble-qr-success" data-assemble-qr-wrap hidden>
                            <span>Generated Pallet QR Code</span>
                            <img src="" alt="Pallet QR code" data-assemble-qr-image />
                            <strong data-assemble-qr-code></strong>
                        </div>
                        <button type="button" data-assemble-message-close>OK</button>
                    </div>
                </section>

                <section class="apts-assemble-bypass-modal" data-assemble-bypass hidden aria-label="Member bypass confirmation">
                    <div class="apts-assemble-bypass-modal__panel">
                        <div class="apts-assemble-bypass-modal__title">
                            <img src="~/assets/images/brand-logos/ayasto-logo.png" alt="" />
                            <strong>Member Bypass</strong>
                        </div>
                        <p data-assemble-bypass-message>The member is not available at the selected location. Do you want to continue?</p>
                        <div class="apts-assemble-bypass-modal__actions">
                            <button type="button" data-assemble-bypass-cancel>Cancel</button>
                            <button type="button" data-assemble-bypass-continue>Continue</button>
                        </div>
                    </div>
                </section>
            </div>
        </section>

        <section class="apts-qr-modal" data-qr-scanner hidden aria-label="QR code scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Scan QR Code</p>
                    <button type="button" data-qr-close aria-label="Close scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera">
                    <video data-qr-video playsinline muted></video>
                    <span></span>
                </div>
                <p class="apts-qr-modal__status" data-qr-status>Point the camera at the QR code.</p>
            </div>
        </section>
    </main>

    <script src="~/Scripts/apts-custom-select.js"></script>
    <script src="@Url.Content("~/Scripts/apts-qr-scanner.js")?v=20260611-1"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260722-1"></script>
    <script src="@Url.Content("~/Scripts/apts-pallet-assemble.js")?v=20261026-bypass-member-quantity"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


