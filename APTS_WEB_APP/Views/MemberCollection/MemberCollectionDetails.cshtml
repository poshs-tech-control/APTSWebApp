@using System.Collections.Generic
@{
    Layout = null;
    ViewBag.Title = "Member Collection";
    var setup = ViewBag.Setup as APTS_WEB_APP.Models.MemberCollection.MemberCollectionSetupInput
        ?? new APTS_WEB_APP.Models.MemberCollection.MemberCollectionSetupInput();
    var transportList = ViewBag.TransportList as List<APTS_WEB_APP.Models.MemberCollection.TransportItem>
        ?? new List<APTS_WEB_APP.Models.MemberCollection.TransportItem>();
    var members = setup.Members ?? new List<APTS_WEB_APP.Models.MemberCollection.CollectionMemberItem>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Member Collection - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260630-4" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Member Collection details screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("MemberCollection", "MemberCollection")" aria-label="Back to member collection">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title"><p>Member Collection</p></section>

        <form class="apts-member-form apts-member-collection-details-form"
              action="@Url.Action("SaveMemberCollection", "MemberCollection")"
              method="post"
              data-member-collection-details-form
              data-member-collection-save-url="@Url.Action("SaveMemberCollection", "MemberCollection")"
              data-member-collection-success-url="@Url.Action("MemberCollection", "MemberCollection")"
              data-member-collection-challan-url="@Url.Action("GenerateMemberCollectionChallan", "Challan")">
            <input type="hidden" name="FromLocation" value="@setup.Customer" />
            <input type="hidden" name="TransportCode" data-member-collection-transport-code />
            @for (var index = 0; index < members.Count; index++)
            {
                <input type="hidden" name="Members[@index].CustDismentleCode" value="@members[index].CustDismentleCode" />
                <input type="hidden" name="Members[@index].CustCode" value="@members[index].CustCode" />
                <input type="hidden" name="Members[@index].RFIDNo" value="@members[index].RFIDNo" />
                <input type="hidden" name="Members[@index].MemberType" value="@members[index].MemberType" />
                <input type="hidden" name="Members[@index].MemberSize" value="@members[index].MemberSize" />
                <input type="hidden" name="Members[@index].ActionType" value="@members[index].ActionType" />
            }

            <fieldset class="apts-receipt-source" data-member-collection-transport-mode>
                <legend>Transport Details</legend>
                <label><input type="radio" name="TransportEntryMode" value="Master" checked data-member-collection-transport-mode-option /><span>Transport Master</span></label>
                <label><input type="radio" name="TransportEntryMode" value="Other" data-member-collection-transport-mode-option /><span>Other</span></label>
            </fieldset>

            <div class="apts-field apts-custom-select-field" data-member-collection-truck-field>
                <label for="MemberCollectionTruckCode">Truck List</label>
                <input id="MemberCollectionTruckCode" type="hidden" data-custom-select-value data-member-collection-truck-code />
                <div class="apts-custom-select" data-custom-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>Select Truck</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu" role="listbox" hidden data-custom-select-menu>
                        @foreach (var truck in transportList)
                        {
                            string vehicleNo = string.IsNullOrWhiteSpace(truck.VehicleNo) ? truck.TransportCode : truck.VehicleNo;
                            <button type="button"
                                    role="option"
                                    data-value="@truck.TransportCode"
                                    data-truck-no="@truck.VehicleNo"
                                    data-driver-name="@truck.DriverName"
                                    data-driver-contact="@truck.MobileNo"
                                    data-transporter-name="@truck.TransporterName">
                                @vehicleNo
                            </button>
                        }
                        @if (transportList.Count == 0)
                        {
                            <button type="button" role="option" data-value="" disabled>No truck found</button>
                        }
                    </div>
                </div>
            </div>

            <div class="apts-field">
                <label for="CollectionTruckNo">Truck Number</label>
                <input id="CollectionTruckNo" name="TruckNo" type="text" placeholder="Truck Number"
                       maxlength="10"
                       data-member-collection-truck-number
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();" />
            </div>
            <div class="apts-field">
                <label for="DriverName">Driver Name</label>
                <input id="DriverName" name="DriverName" type="text" placeholder="Driver Name"
                       data-member-collection-driver-name
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();" />
            </div>
            <div class="apts-field">
                <label for="DriverContactNo">Driver Contact No.</label>
                <input id="DriverContactNo" name="DriverContactNo" type="tel" placeholder="Driver Contact No." inputmode="tel"
                       data-member-collection-driver-contact
                       maxlength="10" />
            </div>
            <div class="apts-field">
                <label for="TransporterName">Transporter Name</label>
                <input id="TransporterName" name="TransporterName" type="text" placeholder="Transporter Name"
                       data-member-collection-transporter-name
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();" />
            </div>

            <button class="apts-form-submit apts-member-collection-submit" type="submit">Submit</button>
            <p class="apts-form-save-status" data-member-collection-save-status aria-live="polite"></p>
        </form>
    </main>
    <script src="~/Scripts/apts-custom-select.js"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260622-1"></script>
    <script src="@Url.Content("~/Scripts/apts-member-collection-details.js")?v=20260707-2"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>



