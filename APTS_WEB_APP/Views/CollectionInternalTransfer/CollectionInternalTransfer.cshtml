@{
    Layout = null;
    ViewBag.Title = "Collection Internal Transfer";
    var truckList = ViewBag.TruckList as List<APTS_WEB_APP.Models.InternalTransfer.TransportItem> ?? new List<APTS_WEB_APP.Models.InternalTransfer.TransportItem>();
    var factoryLocations = ViewBag.FactoryLocations as List<APTS_WEB_APP.Models.InternalTransfer.LocationItem> ?? new List<APTS_WEB_APP.Models.InternalTransfer.LocationItem>();
    var warehouseLocations = ViewBag.WarehouseLocations as List<APTS_WEB_APP.Models.InternalTransfer.LocationItem> ?? new List<APTS_WEB_APP.Models.InternalTransfer.LocationItem>();
    var clientLocations = ViewBag.ClientLocations as List<APTS_WEB_APP.Models.InternalTransfer.CustomerItem> ?? new List<APTS_WEB_APP.Models.InternalTransfer.CustomerItem>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Collection Internal Transfer - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260630-6" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Collection Internal Transfer screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Collection Internal Transfer</p>
        </section>

        <form class="apts-member-form apts-transfer-form"
              action="@Url.Action("CollectionInternalTransferDetails", "CollectionInternalTransfer")"
              method="post"
              data-collection-transfer-form
              data-collection-transfer-validation-url="@Url.Action("ValidateCollectionTransferMember", "CollectionInternalTransfer")"
              data-collection-transfer-bypass-url="@Url.Action("ContinueCollectionTransferBypass", "CollectionInternalTransfer")">
            <input id="CollectionTruck" name="userLocationType" type="hidden" value="Collection Truck" />
            <fieldset class="apts-receipt-source" data-collection-transfer-transport-mode>
                <legend>Transport Details</legend>
                <label><input type="radio" name="CollectionTransportEntryMode" value="Master" checked data-collection-transfer-transport-mode-option /><span>Transport Master</span></label>
                <label><input type="radio" name="CollectionTransportEntryMode" value="Other" data-collection-transfer-transport-mode-option /><span>Other</span></label>
            </fieldset>

            <div class="apts-field apts-custom-select-field" data-collection-transfer-truck-field>
                <label for="CollectionTruckNo">Truck List</label>
                <input id="CollectionTruckNo" name="userLocation" type="hidden" required data-custom-select-value data-collection-truck-code />
                <input id="CollectionTruckVehicleNo" name="truckNo" type="hidden" data-collection-truck-no />
                <input id="CollectionTruckDriverName" name="driverName" type="hidden" data-collection-driver-name />
                <input id="CollectionTruckDriverContactNo" name="driverContactNo" type="hidden" data-collection-driver-contact />
                <input id="CollectionTruckTransporterName" name="transporterName" type="hidden" data-collection-transporter />
                <div class="apts-custom-select" data-custom-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>Select Truck</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu" role="listbox" hidden data-custom-select-menu>
                        @foreach (var truck in truckList)
                        {
                            <button type="button"
                                    role="option"
                                    data-value="@truck.TransportCode"
                                    data-truck-no="@truck.VehicleNo"
                                    data-driver-name="@truck.DriverName"
                                    data-driver-contact="@truck.MobileNo"
                                    data-transporter-name="@truck.TransporterName">
                                @truck.VehicleNo
                            </button>
                        }
                        @if (truckList.Count == 0)
                        {
                            <button type="button" role="option" data-value="" disabled>No truck found</button>
                        }
                    </div>
                </div>
            </div>

            <div class="apts-field" data-collection-transfer-manual-truck-field hidden>
                <label for="CollectionManualTruckNo">Truck Number</label>
                <input id="CollectionManualTruckNo" type="text" placeholder="Truck Number"
                       maxlength="10"
                       data-collection-manual-truck-no
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();" />
            </div>

            <div class="apts-field">
                <label for="CollectionTransferMember">Member no.</label>
                <div class="apts-scan-input apts-receipt-scan-input">
                    <input id="CollectionTransferMember" name="CollectionTransferMember" type="text" placeholder="Member no." data-collection-transfer-input inputmode="text" />
                    <button type="button" aria-label="Scan member QR code" data-scan-target="#CollectionTransferMember">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h2v2H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z" /></svg>
                    </button>
                </div>
                <p class="apts-field-status" data-collection-transfer-status aria-live="polite"></p>
            </div>

            <div class="apts-predispatch-command-row">
                <button class="apts-form-submit" type="button" data-collection-transfer-add>Add</button>
                <button class="apts-form-submit" type="button" data-collection-transfer-summary>Summary</button>
            </div>

            <div class="apts-scan-summary">
                <span>Scanned Members</span>
                <strong data-collection-transfer-count>0</strong>
            </div>

            <section class="apts-scanned-members" data-collection-transfer-list>
                <p>No members scanned yet.</p>
            </section>

            <div class="apts-form-divider apts-receipt-mode">To</div>

            <fieldset class="apts-receipt-source">
                <legend>To Location Type</legend>
                <label><input type="radio" name="toLocationType" value="Factory" /><span>Factory</span></label>
                <label><input type="radio" name="toLocationType" value="Warehouse" checked /><span>Warehouse</span></label>
                <label><input type="radio" name="toLocationType" value="Client" /><span>Client</span></label>
            </fieldset>

            <div class="apts-field apts-custom-select-field">
                <label for="CollectionToLocation">To Location</label>
                <input id="CollectionToLocation" name="toLocation" type="hidden" required data-custom-select-value />
                <div class="apts-custom-select" data-custom-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>Select To Location</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu" role="listbox" hidden data-custom-select-menu>
                        @foreach (var location in factoryLocations)
                        {
                            <button type="button" role="option" data-transfer-location-option data-group="Factory" data-value="@location.LocationCode">@location.LocationTitle</button>
                        }
                        @foreach (var location in warehouseLocations)
                        {
                            <button type="button" role="option" data-transfer-location-option data-group="Warehouse" data-value="@location.LocationCode">@location.LocationTitle</button>
                        }
                        @foreach (var customer in clientLocations)
                        {
                            <button type="button" role="option" data-transfer-location-option data-group="Client" data-value="@customer.LocationCode">@customer.CustName</button>
                        }
                        <button type="button" role="option" data-transfer-empty hidden>No location found</button>
                    </div>
                </div>
            </div>

            <div class="apts-transfer-actions">
                <button class="apts-form-submit" type="button" data-collection-transfer-clear>Clear</button>
                <button class="apts-form-submit" type="submit">Next</button>
            </div>

            <section class="apts-assemble-bypass-modal" data-collection-transfer-bypass hidden aria-label="Member bypass confirmation">
                <div class="apts-assemble-bypass-modal__panel">
                    <div class="apts-assemble-bypass-modal__title">
                        <img src="~/assets/images/brand-logos/ayasto-logo.png" alt="" />
                        <strong>Member Bypass</strong>
                    </div>
                    <p data-collection-transfer-bypass-message>The member is not in Member Collection status. Do you want to continue?</p>
                    <div class="apts-assemble-bypass-modal__actions">
                        <button type="button" data-collection-transfer-bypass-cancel>Cancel</button>
                        <button type="button" data-collection-transfer-bypass-continue>Continue</button>
                    </div>
                </div>
            </section>
        </form>


        <section class="apts-receipt-group-modal" data-collection-transfer-group-modal hidden aria-label="Collection transfer member details">
            <div class="apts-receipt-group-modal__panel">
                <div class="apts-receipt-group-modal__head">
                    <div>
                        <h2 data-collection-transfer-group-size>Members Size</h2>
                        <strong data-collection-transfer-group-count>Count: 0</strong>
                    </div>
                    <button type="button" data-collection-transfer-group-close aria-label="Close member details">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-receipt-group-modal__body">
                    <table class="apts-receipt-group-table">
                        <thead>
                            <tr>
                                <th>Sr No</th>
                                <th>Type</th>
                                <th>Members</th>
                            </tr>
                        </thead>
                        <tbody data-collection-transfer-group-body></tbody>
                    </table>
                </div>
            </div>
        </section>
        <section class="apts-qr-modal" data-qr-scanner hidden aria-label="QR code scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Scan QR Code</p>
                    <button type="button" data-qr-close aria-label="Close scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera">
                    <video data-qr-video playsinline muted></video>
                    <span></span>
                </div>
                <p class="apts-qr-modal__status" data-qr-status>Point the camera at the QR code.</p>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/Scripts/apts-qr-scanner.js")?v=20260611-1"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260604"></script>
    <script src="@Url.Content("~/Scripts/apts-background-challan.js")?v=20260731-1"></script>
    <script src="@Url.Content("~/Scripts/apts-collection-internal-transfer.js")?v=20260713-1"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>



