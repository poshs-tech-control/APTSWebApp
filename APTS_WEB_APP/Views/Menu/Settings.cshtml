@{
    Layout = null;
    ViewBag.Title = "Settings";
    string selectedLanguage = Convert.ToString(ViewBag.SelectedLanguage);
    if (string.IsNullOrWhiteSpace(selectedLanguage))
    {
        selectedLanguage = "en";
    }

    var languages = new[]
    {
        new { Code = "en", Name = "English" },
        new { Code = "hi", Name = "Hindi" },
        new { Code = "mr", Name = "Marathi" },
        new { Code = "gu", Name = "Gujarati" },
        new { Code = "ta", Name = "Tamil" },
        new { Code = "te", Name = "Telugu" },
        new { Code = "kn", Name = "Kannada" },
        new { Code = "ml", Name = "Malayalam" }
    };

    string selectedLanguageText = "English";
    foreach (var language in languages)
    {
        if (string.Equals(language.Code, selectedLanguage, StringComparison.OrdinalIgnoreCase))
        {
            selectedLanguageText = language.Name;
            break;
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Settings - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260701-2" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen apts-settings-screen" aria-label="APTS settings screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>

            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>

            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />

            <a class="apts-form-icon-button" href="@Url.Action("Login", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Settings</p>
        </section>

        <form class="apts-member-form apts-settings-form" action="@Url.Action("Settings", "Menu")" method="post">
            @Html.AntiForgeryToken()

            <div class="apts-settings-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" />
                    <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 0 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21a2 2 0 0 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1A2 2 0 0 1 4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.3 7A2 2 0 0 1 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1A2 2 0 0 1 19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.1a2 2 0 0 1 0 4H21a1.7 1.7 0 0 0-1.6 1Z" />
                </svg>
            </div>

            <div class="apts-field">
                <label for="Language">Language</label>
                <select id="Language" name="language">
                    @foreach (var language in languages)
                    {
                        <option value="@language.Code" selected="@(string.Equals(selectedLanguage, language.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                            @language.Name
                        </option>
                    }
                </select>
            </div>

            <button class="apts-form-submit" type="submit">Save Settings</button>

            @if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.SettingsMessage)))
            {
                <p class="apts-form-save-status is-valid" aria-live="polite">@ViewBag.SettingsMessage</p>
            }
            else
            {
                <p class="apts-form-save-status" aria-live="polite">Selected language: @selectedLanguageText</p>
            }
        </form>
    </main>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>
