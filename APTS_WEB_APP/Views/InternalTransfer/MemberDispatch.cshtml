@{
    Layout = null;
    ViewBag.Title = "Internal Transfer";
    var setup = ViewBag.Setup as APTS_WEB_APP.Models.InternalTransfer.DispatchSetupInput ?? new APTS_WEB_APP.Models.InternalTransfer.DispatchSetupInput();
    var members = setup.Members ?? new List<APTS_WEB_APP.Models.InternalTransfer.TransferMemberInput>();
    var truckList = ViewBag.TruckList as List<APTS_WEB_APP.Models.InternalTransfer.TransportItem> ?? new List<APTS_WEB_APP.Models.InternalTransfer.TransportItem>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Internal Transfer - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260629-4" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Internal Transfer dispatch screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("InternalTransfer", "InternalTransfer", new { restoreDraft = "true" })" aria-label="Back to internal transfer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Internal Transfer</p>
        </section>

        <form class="apts-member-form apts-transfer-dispatch-form"
              action="@Url.Action("SubmitMemberDispatch", "InternalTransfer")"
              method="post"
              data-transfer-dispatch-form
              data-save-url="@Url.Action("SubmitMemberDispatch", "InternalTransfer")"
              data-challan-url="@Url.Action("GenerateMemberDispatchChallan", "Challan")">
            <input type="hidden" name="UserLocationType" value="@setup.UserLocationType" />
            <input type="hidden" name="UserLocation" value="@setup.UserLocation" />
            <input type="hidden" name="ToLocationType" value="@setup.ToLocationType" />
            <input type="hidden" name="ToLocation" value="@setup.ToLocation" />
            @for (int index = 0; index < members.Count; index++)
            {
                <input type="hidden" name="Members[@index].Rfid" value="@members[index].Rfid" />
                <input type="hidden" name="Members[@index].TagRfid" value="@members[index].TagRfid" />
                <input type="hidden" name="Members[@index].MemberCode" value="@members[index].MemberCode" />
                <input type="hidden" name="Members[@index].MemberType" value="@members[index].MemberType" />
                <input type="hidden" name="Members[@index].MemberSize" value="@members[index].MemberSize" />
                <input type="hidden" name="Members[@index].MemberWeight" value="@members[index].MemberWeight" />
                <input type="hidden" name="Members[@index].MemberDimension" value="@members[index].MemberDimension" />
            }

            <fieldset class="apts-receipt-source" data-internal-transfer-transport-mode>
                <legend>Transport Details</legend>
                <label><input type="radio" name="TransportEntryMode" value="Master" checked data-internal-transfer-transport-mode-option /><span>Transport Master</span></label>
                <label><input type="radio" name="TransportEntryMode" value="Other" data-internal-transfer-transport-mode-option /><span>Other</span></label>
            </fieldset>

            <div class="apts-field apts-custom-select-field" data-internal-transfer-truck-field>
                <label for="InternalTransferTruckCode">Truck List</label>
                <input id="InternalTransferTruckCode" type="hidden" data-custom-select-value data-internal-transfer-truck-code />
                <div class="apts-custom-select" data-custom-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>Select Truck</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu" role="listbox" hidden data-custom-select-menu>
                        @foreach (var truck in truckList)
                        {
                            <button type="button"
                                    role="option"
                                    data-value="@truck.TransportCode"
                                    data-truck-no="@truck.VehicleNo"
                                    data-driver-name="@truck.DriverName"
                                    data-driver-contact="@truck.MobileNo"
                                    data-transporter-name="@truck.TransporterName">
                                @truck.VehicleNo
                            </button>
                        }
                        @if (truckList.Count == 0)
                        {
                            <button type="button" role="option" data-value="" disabled>No truck found</button>
                        }
                    </div>
                </div>
            </div>

            <div class="apts-field">
                <label for="TruckNumber">Truck Number</label>
                <input id="TruckNumber" name="TruckNumber" type="text" placeholder="Truck Number"
                       maxlength="10"
                       data-internal-transfer-truck-number
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();" />
            </div>

            <div class="apts-field">
                <label for="DriverName">Driver Name</label>
                <input id="DriverName" name="DriverName" type="text" placeholder="Driver Name"
                       data-internal-transfer-driver-name
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();" />
            </div>

            <div class="apts-field">
                <label for="DriverContactNo">Driver Contact No.</label>
                <input id="DriverContactNo" name="DriverContactNo" type="tel" placeholder="Driver Contact No." inputmode="tel"
                       data-internal-transfer-driver-contact
                       maxlength="10" />
            </div>

            <div class="apts-field">
                <label for="TransporterName">Transporter Name</label>
                <input id="TransporterName" name="TransporterName" type="text" placeholder="Transporter Name"
                       data-internal-transfer-transporter-name
                       style="text-transform: uppercase;"
                       oninput="this.value = this.value.toUpperCase();" />
            </div>

            <label class="apts-transfer-check">
                <input type="hidden" name="GenerateChallan" value="true" />
                <input type="checkbox" value="true" checked disabled aria-disabled="true" />
                <span>Generate &amp; Email Challan</span>
            </label>

            <div class="apts-transfer-actions">
                <button class="apts-form-submit" type="reset">Clear</button>
                <button class="apts-form-submit" type="submit">Submit</button>
            </div>

            <p class="apts-form-save-status" data-transfer-dispatch-status aria-live="polite"></p>
        </form>
    </main>
    <script src="~/Scripts/apts-custom-select.js"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260604"></script>
    <script src="@Url.Content("~/Scripts/apts-internal-transfer-dispatch.js")?v=20260707-2"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>



