@{
    Layout = null;
    ViewBag.Title = "Pallet Disassemble Customer";
    var toCustomerList = ViewBag.ToCustomerList as System.Collections.Generic.List<APTS_WEB_APP.Models.PalletDispatcch.ShipToLocationItem>
        ?? new System.Collections.Generic.List<APTS_WEB_APP.Models.PalletDispatcch.ShipToLocationItem>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Pallet Disassemble Customer - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260724-2" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Pallet Disassemble Customer screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Pallet Disassemble Customer</p>
        </section>

        <form class="apts-member-form apts-disassemble-customer-form" action="#" method="post" data-disassemble-customer-form data-disassemble-customer-validation-url="@Url.Action("ValidateDisassembleCustomerMember", "PalletDisassembleCustomer")" data-disassemble-customer-temp-save-url="@Url.Action("SaveDisassembleCustomerTemp", "PalletDisassembleCustomer")" data-disassemble-customer-temp-clear-url="@Url.Action("ClearDisassembleCustomerTemp", "PalletDisassembleCustomer")" data-disassemble-customer-temp-details-url="@Url.Action("GetDisassembleCustomerTempDetails", "PalletDisassembleCustomer")" data-disassemble-customer-submit-url="@Url.Action("SubmitDisassembleCustomer", "PalletDisassembleCustomer")" data-disassemble-customer-challan-url="@Url.Action("GeneratePalletDismentleChallan", "Challan")">
            <div class="apts-field apts-custom-select-field">
                <label for="DisassembleCustomer">To Customer</label>
                <input id="DisassembleCustomer" name="customer" type="hidden" required data-custom-select-value />
                <div class="apts-custom-select" data-custom-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>--select--</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu apts-custom-select__menu--searchable" role="listbox" hidden data-custom-select-menu>
                        <input class="apts-custom-select__search" type="search" placeholder="Search customer" aria-label="Search customer" data-custom-select-search />
                        @foreach (var customer in toCustomerList)
                        {
                            <button type="button"
                                    role="option"
                                    data-value="@customer.ShipToLocCode"
                                    data-address="@customer.LocationAddress">
                                @customer.ShipToLocTitle
                            </button>
                        }
                        @if (toCustomerList.Count == 0)
                        {
                            <button type="button" role="option" data-value="">No customer found</button>
                        }
                    </div>
                </div>
            </div>

            <div class="apts-field">
                <label for="CustomerAddress">Address</label>
                <textarea id="CustomerAddress" name="CustomerAddress" placeholder="Customer address" rows="3" readonly></textarea>
            </div>

            <div class="apts-form-divider apts-disassemble-subtitle">Member Current Location</div>

            <fieldset class="apts-dispatch-scan-mode apts-customer-location-mode">
                <legend>Member Current Location</legend>
                <label><input type="radio" name="currentLocation" value="PalletDispatch" checked /><span>Pallet Dispatch</span></label>
                <label><input type="radio" name="currentLocation" value="Other" /><span>Other</span></label>
            </fieldset>

            <div class="apts-field">
                <label for="CustomerDisassembleMember">Scan Members</label>
                <div class="apts-scan-input apts-receipt-scan-input">
                    <input id="CustomerDisassembleMember" name="CustomerDisassembleMember" type="text" placeholder="Member no." data-disassemble-customer-input inputmode="text" />
                    <button type="button" aria-label="Scan member QR code" data-scan-target="#CustomerDisassembleMember">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h2v2H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z" /></svg>
                    </button>
                </div>
            </div>

            <div class="apts-predispatch-command-row">
                <button class="apts-form-submit" type="button" data-disassemble-customer-add>ADD</button>
                <button class="apts-form-submit" type="button" data-disassemble-customer-summary>Summary</button>
            </div>
            <p class="apts-form-save-status" data-disassemble-customer-status aria-live="polite"></p>

            <div class="apts-disassemble-customer-summary">
                <span>Pallet code - <strong data-customer-pallet-code>-</strong></span>
                <button class="apts-disassemble-customer-summary-link" type="button" data-disassemble-customer-all-pallets>All Pallets - <strong data-disassemble-customer-count>0</strong></button>
            </div>

            <section class="apts-scanned-members" data-disassemble-customer-list>
            </section>

            <div class="apts-disassemble-customer-actions">
                <button class="apts-form-submit" type="button" data-disassemble-customer-disassemble>Disassemble</button>
                <button class="apts-form-submit" type="submit" data-disassemble-customer-submit>Submit</button>
                <button class="apts-form-submit" type="button" data-disassemble-customer-discrepancy>Discrepancy</button>
            </div>
        </form>

        <section class="apts-qr-modal" data-qr-scanner hidden aria-label="QR code scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Scan QR Code</p>
                    <button type="button" data-qr-close aria-label="Close scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>
                <div class="apts-qr-modal__camera">
                    <video data-qr-video playsinline muted></video>
                    <span></span>
                </div>
                <p class="apts-qr-modal__status" data-qr-status>Point the camera at the QR code.</p>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/Scripts/apts-qr-scanner.js")?v=20260611-1"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260604"></script>
    <script src="@Url.Content("~/Scripts/apts-pallet-disassemble-customer.js")?v=20260727-discrepancy-validate"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>







