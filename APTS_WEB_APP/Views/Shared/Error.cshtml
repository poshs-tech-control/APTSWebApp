@model System.Web.Mvc.HandleErrorInfo
@{
    Layout = null;
    ViewBag.Title = "Error";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#092338" />
    <title>Error - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260701-1" rel="stylesheet" />
</head>
<body class="apts-login-body">
    <main class="apts-login apts-error" aria-label="APTS error screen">
        <section class="apts-login__panel apts-error__panel">
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-login__logo" alt="Ayasto" />

            <div class="apts-error__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                    <path d="M10.3 4.4 2.6 17.7A1.6 1.6 0 0 0 4 20h16a1.6 1.6 0 0 0 1.4-2.3L13.7 4.4a1.9 1.9 0 0 0-3.4 0Z" />
                </svg>
            </div>

            <div class="apts-login__heading apts-error__heading">
                <p>Ayasto Pallet Tracking System</p>
                <h1>Something went wrong</h1>
            </div>

            <p class="apts-error__message">
                We could not complete your request. Please return to the login page and try again.
            </p>

            <a class="apts-login__button apts-error__button" href="@Url.Action("Login", "Home")">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                </svg>
                Back to Login
            </a>
        </section>

        <p class="apts-login__copyright">
            Copyright &copy; @DateTime.Now.Year Ayasto Steelpac. All rights reserved.
        </p>
    </main>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>
