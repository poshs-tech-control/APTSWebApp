@using System.Collections.Generic
@using System.Linq
@model APTS_WEB_APP.Models.CurrentStockReport
@{
    Layout = null;
    ViewBag.Title = "Member Transaction Report";
    var clientList = Model == null || Model.ClientList == null ? new List<APTS_WEB_APP.Models.CurrentStockReport.DropdownItem>() : Model.ClientList;
    var selectedClient = Model == null ? string.Empty : Model.ClientCode;
    var selectedClientText = clientList.FirstOrDefault(item => item.Value == selectedClient);
    var clientLabel = selectedClientText == null ? "Select Client" : selectedClientText.Text;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Member Transaction Report - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260620-3" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Member Transaction Report screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Report", "Report")" aria-label="Back to reports">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Member Transaction Report</p>
        </section>

        <form class="apts-member-form apts-report-filter-form"
              action="#"
              method="post"
              data-member-transaction-form
              data-location-options-url="@Url.Action("GetCurrentStockClientOptions", "Report")"
              data-report-url="@Url.Action("GetMemberTransactionReport", "Report")">
            <div class="apts-form-divider apts-report-tab">Report</div>

            <fieldset class="apts-report-mode apts-report-mode-four">
                <legend>Location Type</legend>
                <label><input type="radio" name="TransactionLocationType" value="Factory" data-member-transaction-location-mode /><span>Factory</span></label>
                <label><input type="radio" name="TransactionLocationType" value="Warehouse" data-member-transaction-location-mode /><span>Warehouse</span></label>
                <label><input type="radio" name="TransactionLocationType" value="Client" checked data-member-transaction-location-mode /><span>Client</span></label>
                <label><input type="radio" name="TransactionLocationType" value="Truck" data-member-transaction-location-mode /><span>Truck</span></label>
            </fieldset>

            <div class="apts-field apts-custom-select-field" data-member-transaction-location-field>
                <label for="TransactionLocation" data-member-transaction-location-title>Client</label>
                <input id="TransactionLocation" name="TransactionLocation" type="hidden" value="@selectedClient" data-custom-select-value data-member-transaction-location />
                <div class="apts-custom-select" data-custom-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>@clientLabel</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu" role="listbox" hidden data-custom-select-menu>
                        @foreach (var client in clientList)
                        {
                            <button type="button" role="option" data-value="@client.Value" aria-selected="@(client.Value == selectedClient ? "true" : "false")">@client.Text</button>
                        }
                        @if (clientList.Count == 0)
                        {
                            <button type="button" role="option" data-value="" aria-selected="true">No client found</button>
                        }
                    </div>
                </div>
            </div>

            <div class="apts-report-date-row">
                <div class="apts-field">
                    <label for="TransactionFromDate">From Date</label>
                    <input id="TransactionFromDate" name="FromDate" type="date" />
                </div>
                <div class="apts-field">
                    <label for="TransactionToDate">To Date</label>
                    <input id="TransactionToDate" name="ToDate" type="date" />
                </div>
            </div>

            <button class="apts-form-submit apts-report-submit" type="submit">Submit</button>
            <p class="apts-form-save-status" data-member-transaction-status aria-live="polite"></p>

            <div class="apts-report-summary-actions">
                <div class="apts-report-result-title">Member Transaction</div>
                <button class="apts-report-export-button"
                        type="button"
                        data-member-transaction-export
                        title="Download Excel"
                        aria-label="Download Excel"
                        disabled>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                        <path d="M14 3v5h5" />
                        <path d="m9 11 6 6" />
                        <path d="m15 11-6 6" />
                    </svg>
                </button>
            </div>

            <section class="apts-report-table apts-report-table-four" aria-label="Member transaction report result" data-member-transaction-table hidden>
                <div class="apts-report-table__head">
                    <span>From</span>
                    <span>To</span>
                    <span>Status</span>
                    <span>Count</span>
                </div>
                <div class="apts-report-table__body" data-member-transaction-rows></div>
            </section>
        </form>
    </main>

    <script src="~/Scripts/apts-custom-select.js"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260620"></script>
    <script src="@Url.Content("~/Scripts/apts-member-transaction-report.js")?v=20260620-3"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


