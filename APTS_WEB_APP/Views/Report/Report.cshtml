@{
    Layout = null;
    ViewBag.Title = "Reports";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Reports - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260620-3" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen apts-report-screen" aria-label="APTS reports screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>

            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>

            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />

            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Reports</p>
        </section>

        <section class="apts-report-list" aria-label="Report options">
            <a class="apts-report-card" href="@Url.Action("CurrentStockReport", "Report")">
                <span class="apts-report-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H7zM15 3v5h4M9.5 16l2.2-2.6 2.3 1.8 3-4.2M9.5 18h7" /></svg>
                </span>
                <span class="apts-report-card__title">Current Stock Report</span>
                <span class="apts-report-card__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M8 8h8v8M16 8l-9 9" /></svg>
                </span>
            </a>

            <a class="apts-report-card" href="@Url.Action("QueryReport", "Report")">
                <span class="apts-report-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H7zM15 3v5h4M9.5 16l2.2-2.6 2.3 1.8 3-4.2M9.5 18h7" /></svg>
                </span>
                <span class="apts-report-card__title">Query Report</span>
                <span class="apts-report-card__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M8 8h8v8M16 8l-9 9" /></svg>
                </span>
            </a>

            <a class="apts-report-card" href="@Url.Action("DiscrepancyReport", "Report")">
                <span class="apts-report-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H7zM15 3v5h4M9.5 16l2.2-2.6 2.3 1.8 3-4.2M9.5 18h7" /></svg>
                </span>
                <span class="apts-report-card__title">Discrepancy Report</span>
                <span class="apts-report-card__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M8 8h8v8M16 8l-9 9" /></svg>
                </span>
            </a>

            <a class="apts-report-card" href="@Url.Action("HighAgeReport", "Report")">
                <span class="apts-report-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H7zM15 3v5h4M9.5 16l2.2-2.6 2.3 1.8 3-4.2M9.5 18h7" /></svg>
                </span>
                <span class="apts-report-card__title">High Age Pallet Report</span>
                <span class="apts-report-card__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M8 8h8v8M16 8l-9 9" /></svg>
                </span>
            </a>

            <a class="apts-report-card" href="@Url.Action("MemberTransactionReport", "Report")">
                <span class="apts-report-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 3h8l4 4v14H7zM15 3v5h4M9.5 16l2.2-2.6 2.3 1.8 3-4.2M9.5 18h7" /></svg>
                </span>
                <span class="apts-report-card__title">Member Transaction Report</span>
                <span class="apts-report-card__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M8 8h8v8M16 8l-9 9" /></svg>
                </span>
            </a>
        </section>
    </main>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


