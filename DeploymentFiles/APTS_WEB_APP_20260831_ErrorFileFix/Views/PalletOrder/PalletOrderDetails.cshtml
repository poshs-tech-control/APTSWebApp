@{
    Layout = null;
    ViewBag.Title = "Pallet Order Details";
    var palletShape = Request["PalletShape"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Pallet Order Details - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Pallet Order Details screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("PalletOrder", "PalletOrder")" aria-label="Back to pallet order">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Pallet Order Details</p>
        </section>

        <form class="apts-member-form" action="#" method="post">
            <div class="apts-field">
                <label for="PalletShape">Pallet Shape</label>
                <input id="PalletShape" name="PalletShape" type="text" value="@palletShape" placeholder="Pallet Shape" />
            </div>

            <div class="apts-two-column">
                <div class="apts-field">
                    <label for="PalletCount">Pallet Count</label>
                    <input id="PalletCount" name="PalletCount" type="number" min="1" placeholder="Count" />
                </div>
                <div class="apts-field">
                    <label for="SheetWidth">Sheet Width</label>
                    <input id="SheetWidth" name="SheetWidth" type="number" min="1" placeholder="Width" />
                </div>
            </div>

            <div class="apts-two-column">
                <div class="apts-field">
                    <label for="SheetLengthH1">Sheet Length (H1)</label>
                    <input id="SheetLengthH1" name="SheetLengthH1" type="number" min="1" placeholder="H1" />
                </div>
                <div class="apts-field">
                    <label for="SheetLengthH2">Sheet Length (H2)</label>
                    <input id="SheetLengthH2" name="SheetLengthH2" type="number" min="1" placeholder="H2" />
                </div>
            </div>

            <div class="apts-two-column">
                <div class="apts-field">
                    <label for="CMSize">CM Size</label>
                    <input id="CMSize" name="CMSize" type="text" placeholder="CM Size" />
                </div>
                <div class="apts-field">
                    <label for="CMCount">CM Count</label>
                    <input id="CMCount" name="CMCount" type="number" min="0" placeholder="Count" />
                </div>
            </div>

            <div class="apts-two-column">
                <div class="apts-field">
                    <label for="LM1Size">LM1 Size</label>
                    <input id="LM1Size" name="LM1Size" type="text" placeholder="LM1 Size" />
                </div>
                <div class="apts-field">
                    <label for="LM1Count">LM1 Count</label>
                    <input id="LM1Count" name="LM1Count" type="number" min="0" placeholder="Count" />
                </div>
            </div>

            <div class="apts-two-column">
                <div class="apts-field">
                    <label for="LM2Size">LM2 Size</label>
                    <input id="LM2Size" name="LM2Size" type="text" placeholder="LM2 Size" />
                </div>
                <div class="apts-field">
                    <label for="LM2Count">LM2 Count</label>
                    <input id="LM2Count" name="LM2Count" type="number" min="0" placeholder="Count" />
                </div>
            </div>

            <div class="apts-field">
                <label for="TotalPalletMembers">Total Pallet Members</label>
                <input id="TotalPalletMembers" name="TotalPalletMembers" type="number" min="0" placeholder="Total members" />
            </div>

            <button class="apts-form-submit" type="submit">Submit</button>
        </form>
    </main>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260604"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


