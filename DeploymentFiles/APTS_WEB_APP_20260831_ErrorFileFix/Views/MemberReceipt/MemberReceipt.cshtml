@{
    Layout = null;
    ViewBag.Title = "Member Receipt";
    var factoryLocations = ViewBag.FactoryLocations ?? new List<object>();
    var warehouseLocations = ViewBag.WarehouseLocations ?? new List<object>();
    var clientLocations = ViewBag.ClientLocations ?? new List<object>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Member Receipt - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260612-9" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen" aria-label="Member Receipt screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Back to menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>
            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>
            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />
            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Member Receipt</p>
        </section>

        <form class="apts-member-form apts-receipt-form" action="@Url.Action("MemberReceiptScan", "MemberReceipt")" method="get" data-member-receipt-setup-form>
            <div class="apts-form-divider apts-receipt-mode">Received</div>

            <fieldset class="apts-receipt-source">
                <legend>Receipt From</legend>
                <label>
                    <input type="radio" name="receiptFrom" value="Factory" checked />
                    <span>Factory</span>
                </label>
                <label>
                    <input type="radio" name="receiptFrom" value="Warehouse" />
                    <span>Warehouse</span>
                </label>
                <label>
                    <input type="radio" name="receiptFrom" value="Client" />
                    <span>Customer</span>
                </label>
            </fieldset>

            <div class="apts-field apts-custom-select-field">
                <label for="ReceiptLocation">Location</label>
                <input id="ReceiptLocation" name="ReceiptLocation" type="hidden" value="" required data-custom-select-value />
                <input id="ReceiptLocationName" name="ReceiptLocationName" type="hidden" value="" data-receipt-location-name />
                <div class="apts-custom-select" data-custom-select>
                    <button class="apts-custom-select__button" type="button" aria-haspopup="listbox" aria-expanded="false" data-custom-select-button>
                        <span data-custom-select-label>Select Location</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="apts-custom-select__menu" role="listbox" hidden data-custom-select-menu>
                        @foreach (var location in factoryLocations)
                        {
                            <button type="button" role="option" data-receipt-location-option data-group="Factory" data-value="@location.LocationCode">@location.LocationTitle</button>
                        }
                        @foreach (var location in warehouseLocations)
                        {
                            <button type="button" role="option" data-receipt-location-option data-group="Warehouse" data-value="@location.LocationCode">@location.LocationTitle</button>
                        }
                        @foreach (var customer in clientLocations)
                        {
                            <button type="button" role="option" data-receipt-location-option data-group="Client" data-value="@customer.LocationCode">@customer.CustName</button>
                        }
                        <button type="button" role="option" data-receipt-empty hidden>No location found</button>
                    </div>
                </div>
            </div>

            <button class="apts-form-submit" type="submit">Next</button>
        </form>
    </main>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260604"></script>
    <script src="@Url.Content("~/Scripts/apts-member-receipt.js")?v=20260612-2"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


