@{
    Layout = null;
    ViewBag.Title = "Query Report";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071927" />
    <title>Query Report - Ayasto Pallet Tracking System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=20260620-3" rel="stylesheet" />
</head>
<body class="apts-form-body">
    <main class="apts-form-screen apts-query-report-screen" aria-label="Query Report screen">
        <header class="apts-form-header">
            <a class="apts-form-icon-button" href="@Url.Action("Report", "Report")" aria-label="Back to reports">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
            </a>

            <a class="apts-form-icon-button" href="@Url.Action("Menu", "Menu")" aria-label="Home">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20h-5v-5H9v5H4z" /></svg>
            </a>

            <img src="~/assets/images/brand-logos/ayasto-logo.png" class="apts-form-logo" alt="Ayasto" />

            <a class="apts-form-icon-button" href="@Url.Action("Logout", "Home")" aria-label="Logout">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7V5h6v14h-6v-2M4 12h11m0 0-4-4m4 4-4 4" /></svg>
            </a>
        </header>

        <section class="apts-form-title">
            <p>Query Report</p>
        </section>

        <form class="apts-member-form apts-query-report-form"
              action="#"
              method="post"
              data-query-report-form
              data-query-report-url="@Url.Action("GetQueryReport", "Report")">
            <div class="apts-field">
                <label for="QueryMemberNo">Scan any member</label>
                <div class="apts-scan-input apts-query-scan-input">
                    <input id="QueryMemberNo" name="QueryMemberNo" type="text" placeholder="Member no." inputmode="text" data-query-rfid />
                    <button type="button" aria-label="Scan member QR code" data-scan-target="#QueryMemberNo">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M8 8h2v2H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z" /></svg>
                    </button>
                </div>
            </div>

            <button class="apts-form-submit apts-query-submit" type="submit">Submit</button>
            <p class="apts-form-save-status" data-query-status aria-live="polite"></p>

            <div class="apts-form-divider apts-query-report-heading">Report Details</div>

            <section class="apts-query-detail-table" aria-label="Query report details">
                <div class="apts-query-detail-row">
                    <strong>Member ID</strong>
                    <span data-query-field="RFID">-</span>
                </div>
                <div class="apts-query-detail-row">
                    <strong>Tagged RFID</strong>
                    <span data-query-field="AllTagRFIDs">-</span>
                </div>
                <div class="apts-query-detail-row">
                    <strong>From</strong>
                    <span data-query-field="FromLocation">-</span>
                </div>
                <div class="apts-query-detail-row">
                    <strong>To</strong>
                    <span data-query-field="ToLocation">-</span>
                </div>
                <div class="apts-query-detail-row">
                    <strong>Date</strong>
                    <span data-query-field="LastUpdatedDate">-</span>
                </div>
                <div class="apts-query-detail-row">
                    <strong>EntryBy</strong>
                    <span data-query-field="LastEntryBy">-</span>
                </div>
                <div class="apts-query-detail-row">
                    <strong>Status</strong>
                    <span data-query-field="LastStatus">-</span>
                </div>
                <div class="apts-query-detail-row">
                    <strong>Client Batch No</strong>
                    <span data-query-field="ClientBatchNo">-</span>
                </div>
            </section>

            <button class="apts-form-submit apts-query-clear" type="reset">Clear</button>
        </form>

        <section class="apts-qr-modal" data-qr-scanner hidden aria-label="QR code scanner">
            <div class="apts-qr-modal__panel">
                <div class="apts-qr-modal__head">
                    <p>Scan QR Code</p>
                    <button type="button" data-qr-close aria-label="Close scanner">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                </div>

                <div class="apts-qr-modal__camera">
                    <video data-qr-video playsinline muted></video>
                    <span></span>
                </div>

                <p class="apts-qr-modal__status" data-qr-status>Point the camera at the QR code.</p>
            </div>
        </section>
    </main>

    <script src="@Url.Content("~/Scripts/apts-qr-scanner.js")?v=20260602"></script>
    <script src="@Url.Content("~/Scripts/apts-process-popup.js")?v=20260620"></script>
    <script src="@Url.Content("~/Scripts/apts-query-report.js")?v=20260620-3"></script>
    <script src="@Url.Content("~/Scripts/apts-session-history.js")?v=20260701-1"></script>
    <script src="@Url.Content("~/Scripts/apts-language-translator.js")?v=20260702-1"></script>
</body>
</html>


